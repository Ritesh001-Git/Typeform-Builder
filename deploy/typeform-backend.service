[Unit]
Description=Typeform Clone - FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/typeform-clone/backend
EnvironmentFile=/home/ubuntu/typeform-clone/backend/.env
ExecStart=/home/ubuntu/typeform-clone/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target